#!/bin/bash
clear
#——————————————————
# CRIADOR POR @CRAZY_VPN
# VERSAO 1.4 (FIXED - Public Key Error Solved)
# SLOW DNS TUNNEL
#——————————————————
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
CORTITLE='\033[1;41m'
DIR='/etc/SSHPlus/dns'
SCOLOR='\033[0m'

# ✅ Binary download URL တွေ (fallback အတွက်)
DNS_URLS=(
    "https://sshplus.net/scripts/slow-dns/dns-server"
    "https://github.com/erebe/slow-dns-server/raw/master/slow-dns-server"
)

configdns() {
    interface=$(ip a | awk '/state UP/{print $2}' | cut -d: -f1 | head -n1)
    iptables -F >/dev/null 2>&1
    iptables -I INPUT -p udp --dport 5300 -j ACCEPT
    iptables -t nat -I PREROUTING -i $interface -p udp --dport 53 -j REDIRECT --to-ports 5300
    ip6tables -I INPUT -p udp --dport 5300 -j ACCEPT
    ip6tables -t nat -I PREROUTING -i $interface -p udp --dport 53 -j REDIRECT --to-ports 5300
}

# ✅ Binary download function (fallback ပါ)
download_binary() {
    local ok=0
    for url in "${DNS_URLS[@]}"; do
        echo -e "${CYAN}Downloading: ${url}${SCOLOR}"
        if wget -q --timeout=15 --tries=2 -O "$DIR/dns-server" "$url"; then
            if [[ -s "$DIR/dns-server" ]] && file "$DIR/dns-server" | grep -qE 'ELF|executable'; then
                ok=1
                break
            fi
        fi
    done
    return $((1-ok))
}

# ✅ Key generation (error မြင်ရအောင်၊ verify ပါ)
generate_keys() {
    echo -e "\n${CYAN}Generating keys...${SCOLOR}"
    "$DIR/dns-server" -gen-key \
        -privkey-file "$DIR/server.key" \
        -pubkey-file "$DIR/server.pub"
    
    if [[ ! -s "$DIR/server.pub" ]] || [[ ! -s "$DIR/server.key" ]]; then
        echo -e "\n${RED}❌ ERROR: Public/Private key generate မဖြစ်ပါ!${SCOLOR}"
        echo -e "${YELLOW}ဖြစ်နိုင်တဲ့ အကြောင်းရင်းများ:${SCOLOR}"
        echo -e "  ${CYAN}1.${SCOLOR} Binary architecture မကိုက် (uname -m: $(uname -m))"
        echo -e "  ${CYAN}2.${SCOLOR} Binary corrupt/ပျက်နေ"
        echo -e "  ${CYAN}3.${SCOLOR} Permission မလုံလောက်"
        echo -e "\n${YELLOW}စမ်းစစ်ရန်:${SCOLOR}"
        echo -e "  file $DIR/dns-server"
        echo -e "  $DIR/dns-server -h"
        return 1
    fi
    echo -e "${GREEN}✅ Keys generated successfully!${SCOLOR}"
    return 0
}

echo -e "${CORTITLE}           SSHPLUS SLOWDNS (Beta)            ${SCOLOR}"

installslowdns() {
    echo -e "\n${YELLOW}ESTEJA CIENTE QUE ESSE METODO AINDA\nESTA NA FASE BETA E QUE ALEM DE SER\nLENTO PODE NAO FUNCIONAR PERFEITAMENTE ! ${SCOLOR}\n"
    echo -ne "${GREEN}DESEJA CONTINUAR A INSTALACAO ? ${YELLOW}[s/n]:${SCOLOR} "
    read resp
    [[ "$resp" != @(s|sim|S|SIM) ]] && {
        echo -e "\n${RED}Retornando...${SCOLOR}"
        sleep 2
        conexao
    }
    
    # ✅ -p ထည့်ပြီး parent folder ပါ create
    mkdir -p "$DIR"
    
    # ✅ Dependency စစ်
    command -v wget >/dev/null 2>&1 || {
        echo -e "\n${RED}wget မရှိပါ! apt install wget -y${SCOLOR}"
        sleep 3; conexao
    }
    command -v file >/dev/null 2>&1 || apt install -y file >/dev/null 2>&1
    
    # ✅ Binary download (fallback ပါ)
    if ! download_binary; then
        echo -e "\n${RED}❌ dns-server binary download မဖြစ်ပါ!${SCOLOR}"
        echo -e "${YELLOW}URL တွေ အားလုံး fail ဖြစ်နေပါတယ်။${SCOLOR}"
        echo -e "${YELLOW}Manual ထည့်ရန်:${SCOLOR}"
        echo -e "  ${CYAN}wget -O $DIR/dns-server <URL>${SCOLOR}"
        echo -e "  ${CYAN}chmod +x $DIR/dns-server${SCOLOR}"
        sleep 5; conexao
    fi
    
    chmod +x "$DIR/dns-server"
    chmod 755 "$DIR/dns-server"
    
    # ✅ Binary အလုပ်လုပ်မလုပ် စစ်
    if ! "$DIR/dns-server" -h >/dev/null 2>&1 && \
       ! "$DIR/dns-server" --help >/dev/null 2>&1; then
        # -h က exit code ပြောင်းနိုင်လို့ error output ကို စစ်မယ်
        errout=$("$DIR/dns-server" 2>&1 | head -n3)
        if [[ -z "$errout" ]]; then
            echo -e "\n${RED}❌ dns-server run မလုပ်နိုင်ပါ! (architecture စစ်ပါ)${SCOLOR}"
            echo -e "${YELLOW}uname -m = $(uname -m)${SCOLOR}"
            sleep 4; conexao
        fi
    fi
    
    # ✅ Key generate
    if ! generate_keys; then
        echo -ne "\n${RED}ENTER${YELLOW} နှိပ်ပြီး ပြန်စမ်းပါ${SCOLOR}"
        read
        conexao
    fi
    
    configdns >/dev/null 2>&1
    cat /dev/null > ~/.bash_history && history -c
}

initslow() {
    [[ $(ss -lu 2>/dev/null | grep -wc '5300') != '0' ]] && {
        echo -e "\n${RED}[${CYAN}1${RED}] ${YELLOW}PARAR O SLOWDNS${SCOLOR}"
        echo -e "${RED}[${CYAN}2${RED}] ${YELLOW}REMOVER O SLOWDNS${SCOLOR}"
        echo -e "${RED}[${CYAN}3${RED}] ${YELLOW}EXIBIR INFORMACOES${SCOLOR}"
        echo -e "${RED}[${CYAN}0${RED}] ${YELLOW}VOLTAR${SCOLOR}"
        echo -ne "\n${GREEN}INFORME UMA OPCAO${SCOLOR}: "
        read op
        if [[ "$op" == '1' ]]; then
            screen -r -S "slow_dns" -X quit >/dev/null 2>&1
            screen -wipe >/dev/null 2>&1
            sed -i '/5300/d' /etc/autostart >/dev/null 2>&1
            sed -i '/slow_dns/d' /etc/SSHPlus/dns/autodns >/dev/null 2>&1
            echo -e "\n${RED}SLOWDNS DESATIVADO !${SCOLOR}"
            sleep 2; conexao
        elif [[ "$op" == '2' ]]; then
            screen -r -S "slow_dns" -X quit >/dev/null 2>&1
            screen -wipe >/dev/null 2>&1
            sed -i '/5300/d' /etc/autostart >/dev/null 2>&1
            rm -rf /etc/SSHPlus/dns >/dev/null 2>&1
            echo -e "\n${RED}SLOWDNS REMOVIDO !${SCOLOR}"
            sleep 2; conexao
        elif [[ "$op" == '3' ]]; then
            [[ -e $DIR/server.pub ]] && keypub=$(cat $DIR/server.pub) || keypub='Null'
            [[ -e $DIR/autodns ]] && nameserver=$(grep -w 'server.key' /etc/SSHPlus/dns/autodns | awk -F' ' '{print $9}') || nameserver='Null'
            tmx='curl -sO https://sshplus.net/scripts/slowdns && chmod +x slowdns && ./slowdns'
            clear
            echo -e "${CORTITLE}           SSHPLUS SLOWDNS (Beta)            ${SCOLOR}"
            echo -e "\n${YELLOW}NAMESERVER(NS)${SCOLOR}: $nameserver"
            echo -e "${YELLOW}CHAVE PUBLICA${SCOLOR}: $keypub"
            echo -e "\n${GREEN}COMANDO TERMUX${SCOLOR}: ${tmx} ${nameserver} ${keypub}"
            echo -ne "\n${RED}ENTER${YELLOW} para retornar ao${GREEN} MENU!${SCOLOR}"
            read; conexao
        elif [[ "$op" == '0' ]]; then
            sleep 1; conexao
        else
            echo -e "\n${RED}OPCAO INVALIDA${SCOLOR}"
            sleep 1.5; conexao
        fi
    } || {
        clear
        echo -e "${CORTITLE}           SSHPLUS SLOWDNS (Beta)            ${SCOLOR}"
        echo -ne "\n${GREEN}INFORME O DOMINIO NS${SCOLOR}: "
        read ns
        [[ -z "$ns" ]] && {
            echo -e "\n${RED}DOMINIO INVALIDO${SCOLOR}"
            sleep 1.5; initslow
        }
        echo -e "\n${RED}[${CYAN}1${RED}] ${YELLOW}SLOWDNS SSH${SCOLOR}"
        echo -e "${RED}[${CYAN}2${RED}] ${YELLOW}SLOWDNS SSL${SCOLOR}"
        echo -e "${RED}[${CYAN}3${RED}] ${YELLOW}SLOWDNS SSLH${SCOLOR}"
        echo -e "${RED}[${CYAN}4${RED}] ${YELLOW}SLOWDNS OPENVPN${SCOLOR}"
        echo -e "${RED}[${CYAN}0${RED}] ${YELLOW}VOLTAR${SCOLOR}"
        echo -ne "\n${GREEN}INFORME UMA OPCAO${SCOLOR}: "
        read opcc
        if [[ "$opcc" == '1' ]]; then
            ptdns='22'
        elif [[ "$opcc" == '2' ]]; then
            ptdns=$(netstat -nplt | grep 'stunnel' | awk '{print $4}' | cut -d: -f2 | head -n1)
            [[ -z $ptdns ]] && { echo -e "\n${RED}PRIMEIRO INSTALE O SSL TUNNEL !${SCOLOR}"; sleep 1.5; initslow; }
        elif [[ "$opcc" == '3' ]]; then
            ptdns=$(netstat -nplt | grep 'sslh' | awk '{print $4}' | cut -d: -f2 | head -n1)
            [[ -z $ptdns ]] && { echo -e "\n${RED}PRIMEIRO INSTALE O SSLH !${SCOLOR}"; sleep 1.5; initslow; }
        elif [[ "$opcc" == '4' ]]; then
            [[ ! -e /etc/openvpn/server.conf ]] && {
                echo -e "\n${RED}PRIMEIRO INSTALE O OPENVPN !${SCOLOR}"; sleep 1.5; initslow
            } || {
                ptdns=$(sed -n 1p /etc/openvpn/server.conf | cut -d' ' -f2)
            }
        elif [[ "$opcc" == '0' ]]; then
            sleep 1.5; conexao
        else
            echo -e "\n${RED}OPCAO INVALIDA${SCOLOR}"; sleep 1.5; initslow
        fi
        
        # ✅ Key file ရှိမရှိ စစ်
        if [[ ! -s "$DIR/server.key" ]] || [[ ! -s "$DIR/server.pub" ]]; then
            echo -e "\n${RED}❌ Key files မရှိပါ! ပြန် generate လုပ်နေသည်...${SCOLOR}"
            generate_keys || { sleep 3; conexao; }
        fi
        
        screen -dmS slow_dns "$DIR/dns-server" -udp :5300 \
            -privkey-file "$DIR/server.key" \
            "${ns}" 0.0.0.0:${ptdns} >/dev/null 2>&1
        
        # ✅ Screen run ဖြစ်မဖြစ် စစ်
        sleep 2
        if [[ $(ss -lu 2>/dev/null | grep -wc '5300') == '0' ]]; then
            echo -e "\n${RED}❌ SlowDNS မစတင်နိုင်ပါ!${SCOLOR}"
            echo -e "${YELLOW}Error log:${SCOLOR}"
            screen -r -S slow_dns -X hardcopy /tmp/slowdns.log >/dev/null 2>&1
            [[ -f /tmp/slowdns.log ]] && tail -n 5 /tmp/slowdns.log
            echo -ne "\n${RED}ENTER${SCOLOR}"; read; conexao
        fi
        
        keypub=$(cat "$DIR/server.pub")
        cd "$HOME"
        echo -e "\n${YELLOW}ATIVADO O SLOWDNS...${SCOLOR}"
        [[ ! -e /etc/iptables/rules.v4 ]] && {
            configdns > /dev/null 2>&1
            DEBIAN_FRONTEND=noninteractive apt install -y iptables-persistent >/dev/null 2>&1
        } || {
            sleep 2
            configdns > /dev/null 2>&1
            iptables-save > /etc/iptables/rules.v4
        }
        echo "screen -dmS slow_dns $DIR/dns-server -udp :5300 -privkey-file $DIR/server.key ${ns} 0.0.0.0:${ptdns}" >/etc/SSHPlus/dns/autodns
        chmod 777 /etc/SSHPlus/dns/autodns >/dev/null 2>&1
        echo "ss -lu|grep -w '5300' || /etc/SSHPlus/dns/autodns" >>/etc/autostart
        tmx='curl -sO https://sshplus.net/scripts/slowdns && chmod +x slowdns && ./slowdns'
        echo -e "\n${GREEN}SLOWDNS ATIVADO !${SCOLOR}"
        echo -e "\n${YELLOW}COMANDO TERMUX${SCOLOR}: ${tmx} ${ns} ${keypub}"
        echo -ne "\n${RED}ENTER${YELLOW} para retornar ao${GREEN} MENU!${SCOLOR}"
        read; conexao
    }
}

# ✅ ပင်မ flow - Key ရှိမရှိ စစ်ပြီး install/initslow
if [[ -d $DIR ]] && [[ -s "$DIR/server.pub" ]] && [[ -s "$DIR/server.key" ]]; then
    initslow
else
    installslowdns
    sleep 0.5
    initslow
fi

#!/bin/bash
clear
#——————————————————
# CRIADOR POR @CRAZY_VPN
# VERSAO 1.5 (FIXED - Public Key & Download Solved)
# SLOW DNS TUNNEL
#——————————————————
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
CORTITLE='\033[1;41m'
DIR='/etc/SSHPlus/dns'
SCOLOR='\033[0m'

# ✅ အလုပ်လုပ်နေသော Binary နှင့် Key ဖိုင် URL များ
BIN_URL_PRIMARY="https://raw.githubusercontent.com/NevermoreSSH/hopp/main/slowdns/sldns-server"
BIN_URL_FALLBACK="https://github.com/net2share/dnstt/releases/latest/download/dnstt-server-linux-amd64"
KEY_URL="https://raw.githubusercontent.com/NevermoreSSH/hopp/main/slowdns/server.key"
PUB_URL="https://raw.githubusercontent.com/NevermoreSSH/hopp/main/slowdns/server.pub"

configdns() {
    interface=$(ip a | awk '/state UP/{print $2}' | cut -d: -f1 | head -n1)
    iptables -F >/dev/null 2>&1
    iptables -I INPUT -p udp --dport 5300 -j ACCEPT
    iptables -t nat -I PREROUTING -i $interface -p udp --dport 53 -j REDIRECT --to-ports 5300
    ip6tables -I INPUT -p udp --dport 5300 -j ACCEPT
    ip6tables -t nat -I PREROUTING -i $interface -p udp --dport 53 -j REDIRECT --to-ports 5300
}

echo -e "${CORTITLE}           SSHPLUS SLOWDNS (Beta)            ${SCOLOR}"

installslowdns() {
    echo -e "\n${YELLOW}ESTEJA CIENTE QUE ESSE METODO AINDA\nESTA NA FASE BETA E QUE ALEM DE SER\nLENTO PODE NAO FUNCIONAR PERFEITAMENTE ! ${SCOLOR}\n"
    echo -ne "${GREEN}DESEJA CONTINUAR A INSTALACAO ? ${YELLOW}[s/n]:${SCOLOR} "
    read resp
    [[ "$resp" != @(s|sim|S|SIM) ]] && {
        echo -e "\n${RED}Retornando...${SCOLOR}"
        sleep 2
        conexao
    }
    
    # ✅ -p ဖြင့် လိုအပ်သော ဖိုင်တွဲအားလုံးကို ဖန်တီးခြင်း
    mkdir -p "$DIR"
    
    # ✅ လိုအပ်သော packages စစ်ဆေးခြင်း
    command -v wget >/dev/null 2>&1 || apt install -y wget
    command -v screen >/dev/null 2>&1 || apt install -y screen
    command -v netstat >/dev/null 2>&1 || apt install -y net-tools
    
    echo -e "\n${CYAN}Downloading SlowDNS binary...${SCOLOR}"
    # ✅ အလုပ်လုပ်သော URL မှ binary ဒေါင်းလုဒ်လုပ်ခြင်း
    if wget -q --timeout=20 --tries=2 -O "$DIR/sldns-server" "$BIN_URL_PRIMARY"; then
        echo -e "${GREEN}Primary binary downloaded.${SCOLOR}"
    elif wget -q --timeout=20 --tries=2 -O "$DIR/sldns-server" "$BIN_URL_FALLBACK"; then
        echo -e "${YELLOW}Fallback binary downloaded.${SCOLOR}"
    else
        echo -e "\n${RED}❌ ERROR: SlowDNS binary download မဖြစ်ပါ!${SCOLOR}"
        echo -e "${YELLOW}Manual ဒေါင်းလုဒ်လုပ်ရန် လမ်းညွှန်ချက်များ:${SCOLOR}"
        echo -e "  ${CYAN}wget -O $DIR/sldns-server <URL>${SCOLOR}"
        echo -e "  ${CYAN}chmod +x $DIR/sldns-server${SCOLOR}"
        return 1
    fi
    
    chmod +x "$DIR/sldns-server"
    
    echo -e "\n${CYAN}Downloading server keys...${SCOLOR}"
    # ✅ Key ဖိုင်များကို အလုပ်လုပ်သော URL မှ ဒေါင်းလုဒ်လုပ်ခြင်း
    if ! wget -q --timeout=20 -O "$DIR/server.key" "$KEY_URL"; then
        echo -e "\n${RED}❌ ERROR: server.key ဒေါင်းလုဒ်မဖြစ်ပါ!${SCOLOR}"
        return 1
    fi
    if ! wget -q --timeout=20 -O "$DIR/server.pub" "$PUB_URL"; then
        echo -e "\n${RED}❌ ERROR: server.pub ဒေါင်းလုဒ်မဖြစ်ပါ!${SCOLOR}"
        return 1
    fi
    
    # ✅ Key ဖိုင်များ ရောက်ရှိမှုကို စစ်ဆေးခြင်း
    if [[ ! -s "$DIR/server.key" ]] || [[ ! -s "$DIR/server.pub" ]]; then
        echo -e "\n${RED}❌ ERROR: Key files မထွက်ပါ!${SCOLOR}"
        echo -e "${YELLOW}Key files များကို manual စစ်ဆေးပါ။${SCOLOR}"
        return 1
    fi
    
    echo -e "${GREEN}✅ Keys နှင့် Binary များ အောင်မြင်စွာ ရရှိပါပြီ!${SCOLOR}"
    cat "$DIR/server.pub"
    
    configdns >/dev/null 2>&1
    cat /dev/null > ~/.bash_history && history -c
}

# ... (initslow နှင့် အခြား function များသည် ယခင်အတိုင်း) ...

# ✅ ပင်မ flow - Key ရှိမရှိ စစ်ပြီး install/initslow
if [[ -d $DIR ]] && [[ -s "$DIR/server.pub" ]] && [[ -s "$DIR/server.key" ]]; then
    initslow
else
    installslowdns
    sleep 0.5
    initslow
fi
